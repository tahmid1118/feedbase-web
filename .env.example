# ─────────────────────────────────────────────────────────────────────────────
# FeedBoard — Frontend (Next.js) environment.
# Copy to `.env.local` (dev) or set these in your host's env (production).
# Never commit real secrets. See DEPLOYMENT.md for the full production guide.
# ─────────────────────────────────────────────────────────────────────────────

# NextAuth signing secret. REQUIRED. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Canonical public origin of the app, WITH protocol. REQUIRED behind a reverse
# proxy (Nginx, Dokploy/Traefik) — leave it unset there and every NextAuth
# redirect is built against the container's internal origin, so signing out lands
# on `https://localhost:3000/...`. `trustHost: true` does NOT cover this:
# next-auth's reqWithEnvURL() consults only AUTH_URL/NEXTAUTH_URL and otherwise
# uses the request as-is. Read at runtime (not NEXT_PUBLIC_), so a restart
# applies it — no rebuild. Omit in local dev.
# AUTH_URL=https://yourdomain.com

# "Continue with Google". OPTIONAL — leave both blank and the button still
# renders but the sign-in fails, so unset them together or set them together.
# NextAuth reads these two names automatically (no code change needed).
#
# Get them from Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID (type: Web application). Free: sign-in uses only the NON-SENSITIVE
# scopes (openid, email, profile), which avoids the paid security assessment
# that restricted scopes require. While the consent screen is in "Testing" it is
# limited to 100 users — publish it before launch.
#
# Authorised redirect URI must be EXACTLY, one per environment:
#   http://localhost:3000/api/auth/callback/google
#   https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Backend API base URL.
#  - FEEDBOARD_API_BASE_URL is used by Next server components / route handlers
#    (server→backend, can be an internal address like http://127.0.0.1:4562).
#  - NEXT_PUBLIC_FEEDBOARD_API_BASE_URL is used by the browser (client→backend),
#    so it MUST be the public HTTPS URL of the API.
# In production both should be your API's public origin unless you front the API
# on an internal network.
FEEDBOARD_API_BASE_URL=http://localhost:4560
NEXT_PUBLIC_FEEDBOARD_API_BASE_URL=http://localhost:4560

# Root domain for the multi-tenant subdomain portal + the shared auth cookie.
# Dev default is "localhost:3000". In production use your real dotted domain
# WITHOUT protocol, e.g. "feedboardapp.com" (tenant portals live at
# <tenant>.feedboardapp.com — requires a wildcard DNS record + wildcard TLS).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Subdomain of FeedBoard's own dogfooding feedback board (default "feedback").
NEXT_PUBLIC_FEEDBACK_SUBDOMAIN=feedback

# Self-hosted Umami analytics. OPTIONAL — leave both blank to disable tracking
# entirely (the tag only renders when both are set). Deliberately left unset in
# local dev so dev/test traffic doesn't pollute real analytics; set both only
# in production. Values come from the tracking snippet Umami gives you for the
# site (Settings → Websites → your site → Tracking code).
NEXT_PUBLIC_UMAMI_SRC=https://analytics.yourdomain.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Billing provider (client) ────────────────────────────────────────────────
# Must match the backend BILLING_PROVIDER. `paddle` = overlay checkout via
# Paddle.js; `stripe` = redirect to Stripe Checkout (dormant).
NEXT_PUBLIC_BILLING_PROVIDER=paddle
# Paddle client-side token + environment (from the Paddle dashboard). Sandbox
# tokens start `test_`; production tokens `live_`. Env: sandbox | production.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_CHANGE_ME
NEXT_PUBLIC_PADDLE_ENV=sandbox
